digraph solicitudes_reabastecimiento {
node [shape=box, style=filled, fillcolor=lightcyan];
graph [nodesep=2.0, ranksep=1.0];
splines=curved;

sol0 [label="Solicitud de Reabastecimiento\nNúmero de solicitud: 0\nDepartamento Solicitante: MED001\nCantidad: 15\nPrioridad: Urgente\nRazón: W\nEstado: Pendiente", fillcolor=lightyellow];
sol1 [label="Solicitud de Reabastecimiento\nNúmero de solicitud: 1\nDepartamento Solicitante: MED002\nCantidad: 45\nPrioridad: Media\nRazón: WW\nEstado: Pendiente", fillcolor=lightyellow];
sol2 [label="Solicitud de Reabastecimiento\nNúmero de solicitud: 2\nDepartamento Solicitante: MED003\nCantidad: 15\nPrioridad: Alta\nRazón: WWWWW\nEstado: Pendiente", fillcolor=lightyellow];
sol3 [label="Solicitud de Reabastecimiento\nNúmero de solicitud: 3\nDepartamento Solicitante: MED001\nCantidad: 45\nPrioridad: Media\nRazón: 9\nEstado: Pendiente", fillcolor=lightyellow];

{ rank=same; sol0; sol1; sol2; sol3; }

edge [style=invis];
sol0 -> sol1;
sol1 -> sol2;
sol2 -> sol3;

edge [style=solid, constraint=false];
sol0 -> sol1 [color=red, penwidth=2.0];
sol1 -> sol2 [color=red, penwidth=2.0];
sol2 -> sol3 [color=red, penwidth=2.0];
sol3 -> sol0 [color=red, penwidth=2.0];

sol0 -> sol3 [color=black, penwidth=1.5];
sol1 -> sol0 [color=black, penwidth=1.5];
sol2 -> sol1 [color=black, penwidth=1.5];
sol3 -> sol2 [color=black, penwidth=1.5];
}
