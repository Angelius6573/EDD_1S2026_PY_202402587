digraph solicitudes_reabastecimiento {
rankdir=TB;
node [shape=box, style=filled, fillcolor=lightcyan];
graph [nodesep=1.0, ranksep=1.5];

sol0 [label="Solicitud de Reabastecimiento\nNúmero de solicitud: 0\nDepartamento Solicitante: MED001\nCantidad: 15\nPrioridad: Urgente\nRazón: Test 1\nEstado: Pendiente", fillcolor=lightyellow];
sol1 [label="Solicitud de Reabastecimiento\nNúmero de solicitud: 1\nDepartamento Solicitante: MED002\nCantidad: 45\nPrioridad: Media\nRazón: Test 2\nEstado: Pendiente", fillcolor=lightyellow];

{ rank=same; sol0; sol1; }

sol0 -> sol1 [color=red, penwidth=2.0];
sol1 -> sol0 [color=red, penwidth=2.0];

sol0 -> sol1 [color=black, penwidth=1.5, constraint=false];
sol1 -> sol0 [color=black, penwidth=1.5, constraint=false];

sol0 -> sol1 [style=invis, weight=10];
}
