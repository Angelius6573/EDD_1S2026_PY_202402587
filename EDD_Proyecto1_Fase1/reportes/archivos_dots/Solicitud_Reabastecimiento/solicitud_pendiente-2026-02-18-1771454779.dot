digraph solicitudes_reabastecimiento {
charset="UTF-8";
rankdir=TB;
node [shape=box, style=filled];
graph [nodesep=1.0, ranksep=1.5];

sol0 [label="Número de solicitud: 1\nCódigo de medicamento: MED001\nCantidad: 3\nPrioridad: Media\nRazón: Test\nEstado: Desaprobado", fillcolor=red];
sol1 [label="Número de solicitud: 2\nCódigo de medicamento: MED001\nCantidad: 15\nPrioridad: Urgente\nRazón: Test num random\nEstado: Desaprobado", fillcolor=red];
sol2 [label="Número de solicitud: 3\nCódigo de medicamento: MED005\nCantidad: 18\nPrioridad: Alta\nRazón: Test\nEstado: Aprobado", fillcolor=green];
sol3 [label="Número de solicitud: 4\nCódigo de medicamento: MED001\nCantidad: 19\nPrioridad: Urgente\nRazón: Hola admin, soy yo, el waos, wwwww\nEstado: Pendiente", fillcolor=yellow];

{ rank=same; sol0; sol1; sol2; sol3; }

sol0 -> sol1 [color=red, penwidth=2.0];
sol1 -> sol2 [color=red, penwidth=2.0];
sol2 -> sol3 [color=red, penwidth=2.0];
sol3 -> sol0 [color=red, penwidth=2.0];

sol0 -> sol3 [color=black, penwidth=1.5, constraint=false];
sol1 -> sol0 [color=black, penwidth=1.5, constraint=false];
sol2 -> sol1 [color=black, penwidth=1.5, constraint=false];
sol3 -> sol2 [color=black, penwidth=1.5, constraint=false];

sol0 -> sol1 [style=invis, weight=10];
sol1 -> sol2 [style=invis, weight=10];
sol2 -> sol3 [style=invis, weight=10];
}
