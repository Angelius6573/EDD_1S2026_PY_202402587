digraph solicitudes_reabastecimiento {
charset="UTF-8";
rankdir=TB;
node [shape=box, style=filled];
graph [nodesep=1.0, ranksep=1.5];

sol0 [label="Número de solicitud: 1\nCódigo de medicamento: MED006\nCantidad: 4830\nPrioridad: Alta\nRazón: TEST MED006 4830\nEstado: Pendiente", fillcolor=yellow];
sol1 [label="Número de solicitud: 2\nCódigo de medicamento: MED009\nCantidad: 75\nPrioridad: Media\nRazón: TEST MED009 75\nEstado: Aprobado", fillcolor=green];
sol2 [label="Número de solicitud: 3\nCódigo de medicamento: MED001\nCantidad: 159\nPrioridad: Baja\nRazón: TEST MED001 159\nEstado: Aprobado", fillcolor=green];

{rank=same; sol0; sol1; sol2; }

sol0 -> sol1 [color=red, penwidth=2.0];
sol1 -> sol2 [color=red, penwidth=2.0];
sol2 -> sol0 [color=red, penwidth=2.0];

sol0 -> sol2 [color=black, penwidth=1.5, constraint=false];
sol1 -> sol0 [color=black, penwidth=1.5, constraint=false];
sol2 -> sol1 [color=black, penwidth=1.5, constraint=false];

sol0 -> sol1 [style=invis, weight=10];
sol1 -> sol2 [style=invis, weight=10];
}
