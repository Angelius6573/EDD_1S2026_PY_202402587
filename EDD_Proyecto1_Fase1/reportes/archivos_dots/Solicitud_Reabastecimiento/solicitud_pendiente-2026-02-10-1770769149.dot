digraph solicitudes_reabastecimiento {
rankdir=LR;
node [shape=box, style=filled, fillcolor=lightcyan];
graph [nodesep=1.5, ranksep=2.0];
splines=true;

sol0 [label="Solicitud de Reabastecimiento\nNúmero de solicitud: 0\nDepartamento Solicitante: MED001\nCantidad: 15\nPrioridad: Urgente\nRazón: Waos\nEstado: Pendiente", fillcolor=lightyellow];
sol1 [label="Solicitud de Reabastecimiento\nNúmero de solicitud: 1\nDepartamento Solicitante: MED001\nCantidad: 15\nPrioridad: Urgente\nRazón: Waos\nEstado: Pendiente", fillcolor=lightyellow];
sol2 [label="Solicitud de Reabastecimiento\nNúmero de solicitud: 2\nDepartamento Solicitante: MED001\nCantidad: 15\nPrioridad: Urgente\nRazón: Waos\nEstado: Pendiente", fillcolor=lightyellow];
sol3 [label="Solicitud de Reabastecimiento\nNúmero de solicitud: 3\nDepartamento Solicitante: MED002\nCantidad: 45\nPrioridad: Baja\nRazón: TTT\nEstado: Pendiente", fillcolor=lightyellow];
sol4 [label="Solicitud de Reabastecimiento\nNúmero de solicitud: 4\nDepartamento Solicitante: MED003\nCantidad: 59\nPrioridad: Alta\nRazón: LLL\nEstado: Pendiente", fillcolor=lightyellow];

{ rank=same; sol0; sol1; sol2; sol3; sol4; }

sol0 -> sol1 [style=invis, weight=100];
sol1 -> sol2 [style=invis, weight=100];
sol2 -> sol3 [style=invis, weight=100];
sol3 -> sol4 [style=invis, weight=100];

sol0 -> sol1 [color=red, penwidth=2.0, constraint=false];
sol1 -> sol2 [color=red, penwidth=2.0, constraint=false];
sol2 -> sol3 [color=red, penwidth=2.0, constraint=false];
sol3 -> sol4 [color=red, penwidth=2.0, constraint=false];
sol4 -> sol0 [color=red, penwidth=2.0, constraint=false];

sol0 -> sol4 [color=black, penwidth=1.5, constraint=false];
sol1 -> sol0 [color=black, penwidth=1.5, constraint=false];
sol2 -> sol1 [color=black, penwidth=1.5, constraint=false];
sol3 -> sol2 [color=black, penwidth=1.5, constraint=false];
sol4 -> sol3 [color=black, penwidth=1.5, constraint=false];
}
