digraph solicitudes_reabastecimiento {
rankdir=TB;
node [shape=box, style=filled];
graph [nodesep=1.0, ranksep=1.5];

sol0 [label="Número de solicitud: 1\nCódigo de medicamento: MED001\nCantidad: 1\nPrioridad: Urgente\nRazón: Test con codigo unico\nEstado: Pendiente", fillcolor=yellow];
sol1 [label="Número de solicitud: 2\nCódigo de medicamento: MED002\nCantidad: 15\nPrioridad: Media\nRazón: Segundo test con codigo unico\nEstado: Pendiente", fillcolor=yellow];

{ rank=same; sol0; sol1; }

sol0 -> sol1 [color=red, penwidth=2.0];
sol1 -> sol0 [color=red, penwidth=2.0];

sol0 -> sol1 [color=black, penwidth=1.5, constraint=false];
sol1 -> sol0 [color=black, penwidth=1.5, constraint=false];

sol0 -> sol1 [style=invis, weight=10];
}
