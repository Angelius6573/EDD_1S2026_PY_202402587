digraph solicitudes_reabastecimiento {
charset="UTF-8";
rankdir=TB;
node [shape=box, style=filled];
graph [nodesep=1.0, ranksep=1.5];

sol0 [label="Número de solicitud: 1\nCódigo de medicamento: MED001\nCantidad: 15983\nPrioridad: Urgente\nRazón: TEST MED001 15983\nEstado: Pendiente", fillcolor=yellow];
sol1 [label="Número de solicitud: 2\nCódigo de medicamento: MED005\nCantidad: 148\nPrioridad: Alta\nRazón: TEST MED005 148\nEstado: Pendiente", fillcolor=yellow];
sol2 [label="Número de solicitud: 3\nCódigo de medicamento: MED009\nCantidad: 13\nPrioridad: Baja\nRazón: TEST MED009 13\nEstado: Pendiente", fillcolor=yellow];

{rank=same; sol0; sol1; sol2; }

sol0 -> sol1 [color=red, penwidth=2.0];
