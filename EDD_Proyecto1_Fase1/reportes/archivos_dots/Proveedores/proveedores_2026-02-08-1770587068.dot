digraph proveedores {
rankdir=TB;
node [shape=box, style=filled, fillcolor=gray90];
graph [nodesep=1.2, ranksep=0.7];

prov0 [label="Contacto: Casa\nDirección: SSS\nEmpresa: Pruebas\nNIT: 123\nTeléfono: 12345678", fillcolor=lightblue];
prov1 [label="Contacto: JJ\nDirección: casa\nEmpresa: Casa\nNIT: 145\nTeléfono: 12596467", fillcolor=lightblue];

prov0_e0 [label="Código: Waos\nCantidad: 15\nFecha de Entrega: 2025/12/02\nFactura: 123", fillcolor=lightyellow];
prov1_e0 [label="Código: Waos\nCantidad: 26\nFecha de Entrega: 2026/02/16\nFactura: 756", fillcolor=lightyellow];

