digraph inventario {
rankdir=LR;
node [shape=box, style=filled, width=2, height=1];
graph [nodesep=0.5, ranksep=1, splines=true, overlap=false];
n0 [label="Código: \nNombre: \nVence: \nStock: 0", fillcolor=yellow];
n1 [label="Código: \nNombre: \nVence: \nStock: 0", fillcolor=yellow];
n2 [label="Código: \nNombre: \nVence: \nStock: 0", fillcolor=yellow];
n0 -> n1;
n1 -> n0 [style=dashed];
n1 -> n2;
n2 -> n1 [style=dashed];
}
