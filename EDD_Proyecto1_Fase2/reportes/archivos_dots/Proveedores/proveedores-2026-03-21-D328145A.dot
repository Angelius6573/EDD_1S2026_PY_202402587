digraph proveedores {
charset="UTF-8";
rankdir=TB;
node [shape=box, style=filled, fillcolor=gray90];
graph [nodesep=1.2, ranksep=0.7];

  prov0 [label="NIT: 12345678-9\nNombre: MedSupplies Guatemala\nTel: 2222-3333\nDir: Zona 10, Guatemala City", fillcolor=lightblue];
  prov1 [label="NIT: 87654321-0\nNombre: FarmaDistrib S.A.\nTel: 2333-4444\nDir: Zona 4, Guatemala City", fillcolor=lightblue];

  prov0_e0 [label="[MEDICAMENTO] MED-001\nAmoxicilina 500mg\nCantidad: 500", fillcolor=lightyellow];
  prov0_e1 [label="[MEDICAMENTO] MED-002\nParacetamol 500mg\nCantidad: 1000", fillcolor=lightyellow];
  prov0_e2 [label="[EQUIPO] EQU-001\nMonitor de Signos Vitales\nCantidad: 5", fillcolor=lightyellow];
  prov0_e3 [label="[SUMINISTRO] SUM-001\nGuantes Quirurgicos L\nCantidad: 2000", fillcolor=lightyellow];
  prov1_e0 [label="[MEDICAMENTO] MED-003\nIbuprofeno 400mg\nCantidad: 750", fillcolor=lightyellow];
  prov1_e1 [label="[SUMINISTRO] SUM-002\nJeringas 5ml\nCantidad: 3000", fillcolor=lightyellow];

  {rank=same; prov0; prov1; }

  prov0 -> prov0_e0;
  prov0_e0 -> prov0_e1;
  prov0_e1 -> prov0_e2;
  prov0_e2 -> prov0_e3;
  prov1 -> prov1_e0;
  prov1_e0 -> prov1_e1;

  prov0 -> prov1 [constraint=false, style=dashed, color=gray];
  prov1 -> prov0 [constraint=false, style=dashed, color=gray];
  prov0 -> prov1 [style=invis, weight=10];
}
